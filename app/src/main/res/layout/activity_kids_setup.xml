<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kids_setup_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kids_brand_accessibility"
            android:textColor="#6844D6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:letterSpacing="0.08"
            android:text="@string/kids_setup_eyebrow"
            android:textColor="#6844D6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/kids_setup_title"
            android:textColor="#1E232D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/kids_setup_description"
            android:textColor="#586572"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/kids_setup_card"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/kids_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/kids_profile_name"
                android:inputType="textPersonName"
                android:maxLength="60" />

            <EditText
                android:id="@+id/kids_session_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/kids_session_limit_hint"
                android:inputType="number"
                android:maxLength="3" />

            <EditText
                android:id="@+id/kids_parent_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:hint="@string/kids_parent_pin_hint"
                android:inputType="numberPassword"
                android:maxLength="12"
                android:saveEnabled="false" />

            <EditText
                android:id="@+id/kids_parent_pin_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:hint="@string/kids_parent_pin_confirm_hint"
                android:inputType="numberPassword"
                android:maxLength="12"
                android:saveEnabled="false" />

            <TextView
                android:id="@+id/kids_setup_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:layout_marginTop="12dp"
                android:textColor="#B3261E"
                android:visibility="gone" />

            <Button
                android:id="@+id/kids_setup_create"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="@string/kids_setup_create" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
